# ---- LLM (optional) ----
# If set, the Assistant uses Anthropic Claude for reasoning/explanation.
# If unset, the app falls back to a deterministic rule-based responder so the demo always works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Google Cloud Voice (optional) ----
# Credentials MUST stay on the backend. Never expose in frontend JS.
# If unset, the frontend falls back to browser-native Web Speech API + speechSynthesis.
GOOGLE_CLOUD_PROJECT_ID=
# Path to a service-account JSON key file mounted on the server.
GOOGLE_APPLICATION_CREDENTIALS=
# "google" forces the Google provider, "browser" forces browser fallback, "auto" detects.
VOICE_PROVIDER=auto

SESSION_SECRET=change-me-in-production

# ---- Store-and-forward sync (edge -> cloud) ----
# Edge app: where to push locally-generated events.
CLOUD_URL=http://localhost:9000
# Cloud service: PostgreSQL system of record.
CLOUD_DATABASE_URL=postgresql://USER@localhost:5432/cat_cloud
# Local edge (SQLite) outbox path (defaults to data/edge.db).
# EDGE_DB_PATH=
